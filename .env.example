# Copier en .env (jamais commité). Sur le Raspberry Pi, scripts/deploy-pi.sh le crée pour vous.

# production | development (development : mot de passe admin par défaut « noel2026 » si aucun hash)
APP_ENV=production

# Hash du mot de passe admin. Générer avec :
#   docker compose run --rm app python -m app.cli hash-password
# (format scrypt:... sans caractère « $ », compatible Docker Compose)
ADMIN_PASSWORD_HASH=

# Clé de signature des sessions. Laisser vide : une clé aléatoire est créée dans data/secret_key.
SECRET_KEY=

# Durée de session admin (heures) et cookie Secure (true uniquement si vous servez en HTTPS).
SESSION_HOURS=12
COOKIE_SECURE=false

# Jeton du boîtier ESP32 Matter (10 boutons / 10 lampes), à recopier dans firmware/esp32-matter/config.h.
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DEVICE_TOKEN=

# Mode démonstration : le planning est accéléré (game.demo_time_scale dans config/game.yaml).
DEMO_MODE=false
# Facteur d'accélération forcé (décommenter pour surcharger), ex. 60 = 1 h de jeu en 1 min.
# TIME_SCALE=60

# Planificateur automatique des événements de la soirée.
SCHEDULER_ENABLED=true

# Anti-bruteforce de la page de connexion.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

LOG_LEVEL=INFO
LOG_FORMAT=json
TZ=Europe/Paris

# Production uniquement (compose.prod.yml)
HTTP_PORT=80
APP_UID=1000
APP_GID=1000

# Télécommande Zigbee 4 boutons via la ZiGate (docs/telecommande-zigbee.md).
# Décommenter pour démarrer mosquitto + zigbee2mqtt + telecommande avec l'application.
# COMPOSE_PROFILES=zigbee
# Port série de la ZiGate sur le Pi : /dev/ttyUSB0 (ZiGate USB) ou /dev/ttyAMA0 (PiZiGate sur GPIO).
ZIGBEE_SERIAL_PORT=/dev/ttyUSB0
# Interface web Zigbee2MQTT (appairage) : http://noel2026.local:8081
ZIGBEE_FRONTEND_PORT=8081
